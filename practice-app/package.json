{
  "name": "playwright-practice-app",
  "version": "1.0.0",
  "description": "A comprehensive practice application for Playwright/Selenium UI and API automation training.",
  "main": "backend/dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.frontend.json",
    "start": "node backend/dist/server.js",
    "dev": "concurrently -k -n BACKEND,FRONTEND,SERVER -c blue,yellow,green \"tsc -p tsconfig.json -w\" \"tsc -p tsconfig.frontend.json -w\" \"nodemon backend/dist/server.js\"",
    "clean": "rimraf backend/dist"
  },
  "keywords": [
    "playwright",
    "selenium",
    "practice",
    "automation"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "swagger-ui-express": "^5.0.1",
    "undici": "^8.9.0",
    "uuid": "^14.0.2",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.19.43",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^9.0.8",
    "@types/yamljs": "^0.2.34",
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.4",
    "rimraf": "^5.0.7",
    "typescript": "^5.5.4"
  }
}
